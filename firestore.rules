rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 既存のusersコレクションのルール
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid == 'ZAvLKJMPhScz0896tQDhOhdkWrW2');
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // 活動ログ（先生だけが読めます。本人は書き込み、3日より前のものを消せます）
    match /activity/{uid}/ev/{id} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid == 'ZAvLKJMPhScz0896tQDhOhdkWrW2');
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['k', 'd', 't'])
        && request.resource.data.k is string && request.resource.data.k.size() <= 20
        && request.resource.data.d is string && request.resource.data.d.size() <= 200
        && request.resource.data.t is number;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 既存のsharesコレクション（科目・カードの共有）
    match /shares/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner','name','hue','n','json','mt']);
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner','name','hue','n','json','mt']);
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // フィードバック（送信・投稿者本人の閲覧・管理者による閲覧/返信/削除）
    match /feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','name','cat','text','ver','env','t']);
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || request.auth.uid == 'ZAvLKJMPhScz0896tQDhOhdkWrW2');
      allow update: if request.auth != null && request.auth.uid == 'ZAvLKJMPhScz0896tQDhOhdkWrW2'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply','rt']);
      allow delete: if request.auth != null && request.auth.uid == 'ZAvLKJMPhScz0896tQDhOhdkWrW2';
    }

    // 友達と比べる（進み具合）：ドキュメントIDは友達コード。一覧は作れません（コードを知っている人だけが1件読めます）
    match /friendStats/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner','name','lv','pct','wkMin','wkPg','t','av','tt','typed','fr','iv','rk','mg']) && (!('av' in request.resource.data) || request.resource.data.av.size() < 200000) && (!('fr' in request.resource.data) || request.resource.data.fr.size() <= 30);
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner','name','lv','pct','wkMin','wkPg','t','av','tt','typed','fr','iv','rk','mg']) && (!('av' in request.resource.data) || request.resource.data.av.size() < 200000) && (!('fr' in request.resource.data) || request.resource.data.fr.size() <= 30);
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }


    // 友達の通知（友達に追加されたとき。自分の受信箱だけ読んで消せます）
    match /friendInbox/{uid}/items/{id} {
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
        && request.resource.data.keys().hasOnly(['from','name','code','t'])
        && request.resource.data.name.size() <= 40 && request.resource.data.code.size() <= 6;
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
    }

    // プッシュ通知：自分の端末の登録（送るのは、サーバーだけが読み書きします）
    // 書き換えた項目だけを確かめるので、サーバーが書く記録の項目があっても、アプリの書き込みは通ります
    match /pushSubs/{uid}/devices/{dev} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['sub','ua','t','vk','prefs'])
        && request.resource.data.sub.endpoint is string && request.resource.data.sub.endpoint.size() < 1000;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sub','ua','t','vk','prefs'])
        && request.resource.data.sub.endpoint is string && request.resource.data.sub.endpoint.size() < 1000;
    }
    // プッシュ通知：自分の通知の内容と、オンオフ（サーバーが書く記録の項目は、アプリからは変えられません）
    match /pushPlan/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['enabled','items','daily','test','updated','lines','hm','nextAt'])
        && (!('items' in request.resource.data) || request.resource.data.items.size() <= 80)
        && (!('lines' in request.resource.data) || request.resource.data.lines.size() <= 20);
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled','items','daily','test','updated','lines','hm','nextAt'])
        && (!('items' in request.resource.data) || request.resource.data.items.size() <= 80)
        && (!('lines' in request.resource.data) || request.resource.data.lines.size() <= 20);
    }

    // プッシュ通知の診断（送信サーバーが書きます。自分だけ読めます）
    match /pushDiag/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // 管理者からのお知らせ（全員が読める。書く・消すのは管理者だけ）
    match /announcements/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == 'ZAvLKJMPhScz0896tQDhOhdkWrW2'
        && request.resource.data.keys().hasOnly(['text','t','uid'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 500;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == 'ZAvLKJMPhScz0896tQDhOhdkWrW2';
    }

    // 先生からの配信（課題・考査日）：全員向け。読めるのはログイン中の人、書く・消すのは先生だけ
    match /assignAll/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == 'ZAvLKJMPhScz0896tQDhOhdkWrW2'
        && request.resource.data.keys().hasOnly(['id','kind','sub','title','tk','start','end','url','req','due','note','date','t','by'])
        && request.resource.data.kind is string && request.resource.data.sub is string && request.resource.data.sub.size() <= 20
        && (!('title' in request.resource.data) || request.resource.data.title.size() <= 60)
        && (!('url' in request.resource.data) || request.resource.data.url.size() <= 500)
        && (!('note' in request.resource.data) || request.resource.data.note.size() <= 300);
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == 'ZAvLKJMPhScz0896tQDhOhdkWrW2';
    }

    // 先生からの配信：選んだ生徒向け。読めるのはその生徒本人だけ、書く・消すのは先生だけ
    match /assignUser/{uid}/items/{id} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == 'ZAvLKJMPhScz0896tQDhOhdkWrW2'
        && request.resource.data.keys().hasOnly(['id','kind','sub','title','tk','start','end','url','req','due','note','date','t','by'])
        && request.resource.data.kind is string && request.resource.data.sub is string && request.resource.data.sub.size() <= 20
        && (!('title' in request.resource.data) || request.resource.data.title.size() <= 60)
        && (!('url' in request.resource.data) || request.resource.data.url.size() <= 500)
        && (!('note' in request.resource.data) || request.resource.data.note.size() <= 300);
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == 'ZAvLKJMPhScz0896tQDhOhdkWrW2';
    }

    // 管理者からのアンケート（全員が読める。作る・締め切る・消すのは管理者だけ）
    // 投票は、アンケートごとに1人1票（自分の投票だけ書けます。締め切られると書けません）
    match /surveys/{sid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == 'ZAvLKJMPhScz0896tQDhOhdkWrW2'
        && request.resource.data.keys().hasOnly(['q','opts','t','uid','open','free'])
        && request.resource.data.q is string && request.resource.data.q.size() <= 200
        && request.resource.data.opts is list && request.resource.data.opts.size() <= 6
        && (request.resource.data.opts.size() >= 2 || request.resource.data.free == true)
        && request.resource.data.open is bool && (!('free' in request.resource.data) || request.resource.data.free is bool);
      allow update: if request.auth != null && request.auth.uid == 'ZAvLKJMPhScz0896tQDhOhdkWrW2'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open']);
      allow delete: if request.auth != null && request.auth.uid == 'ZAvLKJMPhScz0896tQDhOhdkWrW2';

      match /votes/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && get(/databases/$(database)/documents/surveys/$(sid)).data.open == true
          && request.resource.data.keys().hasOnly(['c','t','txt'])
          && request.resource.data.c is int && request.resource.data.c >= -1
          && request.resource.data.c < get(/databases/$(database)/documents/surveys/$(sid)).data.opts.size()
          && (!('txt' in request.resource.data) || (request.resource.data.txt is string && request.resource.data.txt.size() <= 300));
        allow delete: if false;
      }
    }
  }
}
